{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // ─────────────────────────────────────────────
  // NIXOS RICE
  // jan-rex inspired
  // Nord / Noctalia colors
  // ─────────────────────────────────────────────

  "logo": {
    "type": "builtin",
    "source": "nixos",
    "padding": {
      "top": 2,
      "right": 5
    },
    "color": {
      "1": "#81A1C1",
      "2": "#88C0D0",
      "3": "#5E81AC"
    }
  },

  "display": {
    "separator": "",
    "brightColor": true,

    "color": {
      "keys": "#88C0D0",
      "title": "#D8DEE9",
      "output": "#D8DEE9",
      "separator": "#5E81AC"
    },

    "key": {
      "width": 13
    }
  },

  "modules": [

    {
      "type": "custom",
      "format": "{#81}╔══════════════════════════════╗{#}"
    },

    {
      "type": "title",
      "key": "{#36}║  user       {#keys}║{#}",
      "format": "{user-name}@{host-name}"
    },

    {
      "type": "os",
      "key": "{#36}║  os          {#keys}║{#}",
      "format": "{2}"
    },

    {
      "type": "kernel",
      "key": "{#36}║ 󰒋 kernel      {#keys}║{#}"
    },

    {
      "type": "uptime",
      "key": "{#36}║ 󰅐 uptime      {#keys}║{#}"
    },

    {
      "type": "shell",
      "key": "{#36}║  shell       {#keys}║{#}"
    },

    {
      "type": "wm",
      "key": "{#36}║  wm          {#keys}║{#}"
    },

    {
      "type": "terminal",
      "key": "{#36}║  terminal    {#keys}║{#}"
    },

    {
      "type": "terminalfont",
      "key": "{#36}║  font        {#keys}║{#}"
    },

    {
      "type": "custom",
      "format": "{#81}╠══════════════════════════════╣{#}"
    },

    {
      "type": "cpu",
      "key": "{#39}║ 󰻠 cpu         {#keys}║{#}"
    },

    {
      "type": "gpu",
      "key": "{#39}║ 󰢮 gpu         {#keys}║{#}"
    },

    {
      "type": "memory",
      "key": "{#39}║ 󰍛 memory      {#keys}║{#}"
    },

    {
      "type": "disk",
      "key": "{#39}║ 󰋊 disk        {#keys}║{#}",
      "folders": ["/"]
    },

    {
      "type": "custom",
      "format": "{#81}╠══════════════════════════════╣{#}"
    },

    {
      "type": "colors",
      "key": "{#39}║ 󰏘 colors      {#keys}║{#}",
      "symbol": "circle"
    },

    {
      "type": "custom",
      "format": "{#81}╚══════════════════════════════╝{#}"
    }
  ]
}